{
  "manifest": {
    "id": "forest",
    "name": "Enchanted Forest",
    "description": "A deep green and gold theme inspired by nature.",
    "version": {
      "major": 1,
      "minor": 0,
      "patch": 0
    },
    "compatibleTemplates": ["darsana"]
  },
  "themeTokens": {
    "name": "forest",
    "colors": {
      "light": {
        "primary": "hsl(145, 40%, 30%)",
        "primaryForeground": "hsl(45, 65%, 90%)",
        "secondary": "hsl(145, 30%, 20%)",
        "secondaryForeground": "hsl(0, 0%, 100%)",
        "accent": "hsl(45, 65%, 50%)",
        "accentForeground": "hsl(0, 0%, 10%)",
        "background": "hsl(145, 15%, 95%)",
        "foreground": "hsl(145, 40%, 15%)",
        "muted": "hsl(145, 20%, 85%)",
        "mutedForeground": "hsl(145, 30%, 40%)",
        "border": "hsl(145, 20%, 80%)",
        "input": "hsl(145, 20%, 80%)",
        "ring": "hsl(145, 40%, 30%)"
      }
    },
    "typography": {
      "fonts": {
        "heading": "Cormorant Garamond",
        "body": "Lato",
        "accent": "Cinzel"
      },
      "scale": {
        "h1": {
          "fontFamily": "var(--font-heading)",
          "fontSize": "3.5rem",
          "lineHeight": "1.1",
          "fontWeight": "600"
        },
        "h2": {
          "fontFamily": "var(--font-heading)",
          "fontSize": "2.5rem",
          "lineHeight": "1.2",
          "fontWeight": "600"
        },
        "h3": {
          "fontFamily": "var(--font-heading)",
          "fontSize": "2rem",
          "lineHeight": "1.3",
          "fontWeight": "600"
        },
        "h4": {
          "fontFamily": "var(--font-heading)",
          "fontSize": "1.5rem",
          "lineHeight": "1.4",
          "fontWeight": "500"
        },
        "p": {
          "fontFamily": "var(--font-body)",
          "fontSize": "1rem",
          "lineHeight": "1.6",
          "fontWeight": "400"
        },
        "small": {
          "fontFamily": "var(--font-body)",
          "fontSize": "0.875rem",
          "lineHeight": "1.5",
          "fontWeight": "400"
        }
      }
    },
    "spacing": {
      "xs": "0.25rem",
      "sm": "0.5rem",
      "md": "1rem",
      "lg": "1.5rem",
      "xl": "2rem",
      "container": {
        "padding": "1.5rem",
        "maxWidth": "64rem"
      }
    },
    "radius": {
      "none": "0px",
      "sm": "0.25rem",
      "md": "0.5rem",
      "lg": "1rem",
      "full": "9999px"
    },
    "shadow": {
      "none": "none",
      "sm": "0 1px 2px 0 rgb(0 0 0 / 0.05)",
      "md": "0 4px 6px -1px rgb(0 0 0 / 0.1)",
      "lg": "0 10px 15px -3px rgb(0 0 0 / 0.1)",
      "xl": "0 20px 25px -5px rgb(0 0 0 / 0.1)"
    },
    "border": {
      "width": {
        "sm": "1px",
        "md": "2px",
        "lg": "4px"
      },
      "style": "solid"
    },
    "animation": {
      "speed": {
        "fast": "150ms",
        "normal": "300ms",
        "slow": "500ms"
      },
      "easing": {
        "default": "cubic-bezier(0.4, 0, 0.2, 1)",
        "in": "cubic-bezier(0.4, 0, 1, 1)",
        "out": "cubic-bezier(0, 0, 0.2, 1)",
        "inOut": "cubic-bezier(0.4, 0, 0.2, 1)"
      }
    },
    "background": {
      "default": "var(--color-background)"
    }
  },
  "defaultVariants": {
    "hero": "classic"
  },
  "defaultAnimations": {
    "enabled": true,
    "speed": "slow"
  }
}
